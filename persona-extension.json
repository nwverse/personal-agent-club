{
  "manifest_version": 1,
  "id": "personal-agent-club",
  "name": "Personal Agent Club",
  "version": "0.3.0",
  "description": "Personal agents (paired accounts at Cue, Grok Bot and Groq) as a source on the Agents page: their sessions, messages, sending and search. Accounts are paired on the extension's Accounts page; a Grok Bot account can link its own machine into Persona. The assistant can drive the accounts you hand it.",
  "publisher": "nwverse",
  "engines": {
    "extension_protocol": 1
  },
  "runtime": {
    "command": {
      "linux-amd64": "bin/personal-agent-club-linux-amd64",
      "linux-arm64": "bin/personal-agent-club-linux-arm64",
      "darwin-arm64": "bin/personal-agent-club-darwin-arm64",
      "darwin-amd64": "bin/personal-agent-club-darwin-amd64"
    }
  },
  "activation_events": [
    "on_startup"
  ],
  "contributes": {
    "agent_sources": [
      {
        "id": "pac",
        "name": "Personal Agent Club",
        "providers": [
          "cue",
          "grok_bot",
          "groq"
        ]
      }
    ],
    "ui": [
      {
        "id": "accounts",
        "title": "Accounts",
        "placement": "plugin_page"
      }
    ],
    "connectors": [
      {
        "id": "club",
        "name": "Personal Agent Club",
        "capabilities": [
          "status",
          "tools",
          "actions"
        ],
        "confirm_always": [
          "club_agent_*"
        ]
      }
    ]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "demo_echo": {
        "type": "boolean",
        "title": "Demo echo provider",
        "description": "Adds the in-memory echo provider, which answers every message with its own text. For trying the source out; nothing leaves the program.",
        "default": false
      }
    }
  },
  "permissions": {
    "network": [
      "api.manus.ai",
      "api2.cursor.sh",
      "api.groq.com"
    ]
  }
}
